#!name=哔哩哔哩净化增强·极简版
#!desc=哔哩哔哩 iOS 极简净化：开屏/信息流/直播/播放页去广告；首页顶部固定为直播+热门+推荐；我的页面仅保留个性装扮、会员购、我的钱包。开屏使用 KnowSky404/no-ad-project 脚本。
#!openUrl=https://apps.apple.com/app/id736536022
#!homepage=https://github.com/KnowSky404/no-ad-project
#!author=IMAiCool Custom
#!tag=去广告
#!system=iOS,iPadOS
#!system_version=15
#!loon_version=3.5.1(992)
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bilibili.png
#!date=2026-09-26

[Argument]
displayUpList=select,"auto","show","hide",tag=[动态]最常访问,desc=auto=有直播时显示；show=始终显示；hide=始终隐藏
purifyComment=switch,true,tag=过滤评论区置顶推广,desc=过滤评论区置顶推广内容
optimizeRequest=switch,true,tag=优化评论区加载,desc=配合 ProtoBuf 请求脚本降低评论区异常
sponsorBlock=switch,true,tag=空降助手,desc=根据第三方片段数据跳过视频中的植入/推广片段
bottomBar=select,"classic","minimal","home_dynamic","home","keep",tag=底栏布局,desc=classic=首页+动态+我的；minimal=首页+我的；home_dynamic=首页+动态；home=仅首页；keep=不修改
cleanTopRight=switch,true,tag=顶部右侧净化,desc=仅保留消息入口
purifyHome=switch,true,tag=首页推荐去广告
purifyStory=switch,true,tag=竖屏流去广告
purifyMine=switch,true,tag=我的页面净化
logLevel=select,"error","warn","info","debug","off",tag=日志等级

[Rule]
# 空降助手数据源
DOMAIN,bsbsb.top,PROXY
# 阻止 B 站备用 API 域名绕过 MitM 规则
DOMAIN,api.biliapi.com,REJECT
DOMAIN,app.biliapi.com,REJECT
DOMAIN,api.biliapi.net,REJECT
DOMAIN,app.biliapi.net,REJECT
# P2P / STUN / Tracker
AND,((DOMAIN-SUFFIX,chat.bilibili.com),(OR,((DOMAIN-KEYWORD,stun),(DOMAIN-KEYWORD,tracker),(DOMAIN-KEYWORD,p2p)))),REJECT
DEST-PORT,4480,REJECT-NO-DROP
DEST-PORT,4483,REJECT-NO-DROP
DEST-PORT,8082,REJECT-NO-DROP
DEST-PORT,9102,REJECT-NO-DROP

[Rewrite]
# 直播带货 / 游戏推广
request if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\?/i then reject_dict(200)
request if ${url} ~= /^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\?/i then reject_dict(200)

# 活动入口 / 大会员广告素材（不屏蔽搜索热词接口，降低误杀）
response if ${url} ~= /^https:\/\/ap[ip]\.bilibili\.com\/x\/(resource\/(top\/activity|patch\/tab(\/v2)?)|vip\/ads\/materials)\?/i then response.body.mock("json", `{"code":-404,"message":"-404","ttl":1,"data":null}`, 200)

# 播放页开通会员横幅
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\?/i then response.body.mock("json", `{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}`, 200)
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\?/i then response.json.jq(`del(.data.payment)`)

# PGC 页面推广 Banner
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\?/i then response.json.jq(`if .data.modules then .data.modules |= map(select(.type != "TIP") | if .type == "BANNER" and .module_data.items then .module_data.items |= map(select((.url // "") | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end) end`)

# Tracker 地址收敛
response if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\?/i then response.json.jq(`if .data then .data.domains=["wss://tracker.chat.bilibili.com"] else . end`)
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\?/i then response.json.jq(`.data[][]?="stun.chat.bilibili.com:3478"`)

# 皮肤推广
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?/i then response.json.delete("data.common_equip")

# 首页顶部标签 + 底栏自定义
# 顶部标签 ID：731=直播，477=推荐，478=热门，3502=动画，3503=影视
# 底栏 ID：177=首页，179=动态，181=我的
# classic：首页+动态+我的
response if ${bottomBar} == "classic" && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?/i then response.json.jq(`if .data.bottom then .data.bottom |= map(select((.id // 0) | IN(177,179,181))) else . end`)
# minimal：首页+我的
response if ${bottomBar} == "minimal" && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?/i then response.json.jq(`if .data.bottom then .data.bottom |= map(select((.id // 0) | IN(177,181))) else . end`)
# home_dynamic：首页+动态
response if ${bottomBar} == "home_dynamic" && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?/i then response.json.jq(`if .data.bottom then .data.bottom |= map(select((.id // 0) | IN(177,179))) else . end`)
# home：仅首页
response if ${bottomBar} == "home" && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?/i then response.json.jq(`if .data.bottom then .data.bottom |= map(select((.id // 0) == 177)) else . end`)
# keep：不改底栏

# 首页顶部标签固定为：直播、热门、推荐（推荐默认选中）
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?/i then response.json.jq(`if .data.tab then .data.tab=[{"pos":1,"id":731,"name":"直播","tab_id":"直播tab","uri":"bilibili://live/home"},{"pos":2,"id":478,"name":"热门","tab_id":"热门tab","uri":"bilibili://pegasus/hottopic"},{"pos":3,"id":477,"name":"推荐","tab_id":"推荐tab","uri":"bilibili://pegasus/promo","default_selected":1}] else . end`)
response if ${cleanTopRight} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\?/i then response.json.jq(`if .data.top then .data.top |= map(select((.id // 0) == 176)) else . end`)

# 首页推荐流：只删明确广告字段，尽量保留普通视频/番剧/直播推荐
response if ${purifyHome} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\?/i then response.json.jq(`if .data.items then .data.items |= map(select((.ad_info == null) and (.banner_item == null) and ((.card_goto // "") | IN("ad","banner","cm") | not))) else . end`)

# 竖屏 Story 流
response if ${purifyStory} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\?/i then response.json.jq(`if .data.items then .data.items |= map(select((.ad_info == null) and ((.card_goto // "") | IN("vertical_ad_av","vertical_ad_live","vertical_ad_picture") | not)) | del(.story_cart_icon,.free_flow_toast,.image_infos,.course_info,.game_info)) else . end`)

# “我的”页面极简：仅保留 个性装扮 / 会员购 / 我的钱包
# 保留顶部账号资料本身；删除大会员营销、创作中心、离线缓存/历史/收藏/稍后再看、更多服务等服务区
response if ${purifyMine} == true && ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine(\/ipad)?\?/i then response.json.jq(`if .data then del(.data.answer,.data.live_tip,.data.vip_section,.data.vip_section_v2,.data.modular_vip_section,.data.ipad_sections,.data.ipad_upper_sections,.data.ipad_recommend_sections,.data.ipad_more_sections) | .data.sections_v2=[{"title":"我的服务","items":[{"id":402,"title":"个性装扮","uri":"https://www.bilibili.com/h5/mall/home?navhide=1&f_source=shop&from=myservice","icon":"http://i0.hdslb.com/bfs/archive/0bcad10661b50f583969b5a188c12e5f0731628c.png","common_op_item":{}},{"id":622,"title":"会员购","uri":"bilibili://mall/home","icon":"http://i0.hdslb.com/bfs/archive/19c794f01def1a267b894be84427d6a8f67081a9.png","common_op_item":{}},{"id":404,"title":"我的钱包","uri":"bilibili://bilipay/mine_wallet","icon":"http://i0.hdslb.com/bfs/archive/f416634e361824e74a855332b6ff14e2e7c2e082.png","common_op_item":{}}],"style":1,"button":{}}] else . end`)

# 新版开屏活动列表补充处理（list/show 由下方专用 JS 处理）
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/event\/list2/i then response.json.jq(`if .data then .data.event_list=[] | .data.preload=[] else . end`)

# 青少年模式弹窗 / 默认搜索词 / 播放页部分推广响应
response if ${url} == "https://grpc.biliapi.net/bilibili.app.interface.v1.Teenagers/ModeStatus" then response.body.mock("text","AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA",200,true) | response.header.set("grpc-status","0")
response if ${url} == "https://grpc.biliapi.net/bilibili.app.interface.v1.Search/DefaultWords" then response.body.mock("text","AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=",200,true) | response.header.set("grpc-status","0")
response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$/i then response.body.mock("text","AAAAAAA=",200,true) | response.header.set("grpc-status","0")

[Script]
# 开屏广告：使用你指定的脚本；同时处理 list/show，清空广告列表并延长拉取间隔
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(list|show)/i then script("https://github.com/KnowSky404/no-ad-project/raw/refs/heads/main/loon/scripts/bilibili_splash.js") with tag="移除开屏广告", requires_body=true

# 空降助手
request if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$/i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js", {${logLevel}}) with requires_body=true, binary_body_mode=true, timeout=10, enable=${sponsorBlock}, tag="空降助手"

# 评论区请求优化
request if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$/i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js", {${purifyComment},${logLevel}}) with requires_body=true, binary_body_mode=true, timeout=10, enable=${optimizeRequest}, tag="评论区请求优化"

# 直播间 JSON 广告净化
response if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/(app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(Room|User))\?/i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.json.js") with requires_body=true, tag="直播间净化"

# 内嵌活动网页广告
response if ${url} ~= /^https:\/\/www\.bilibili\.com\/blackboard\/era\/.+\.html\?/i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/webpage.bilibili.js") with requires_body=true, tag="内嵌活动页净化"

# ProtoBuf：播放页/相关推荐/热门/动态/搜索/弹幕/评论/播放接口统一净化
response if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(app\.(show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(unite)?\.v1\.View\/(View|ViewProgress|RelatesFeed|AIRelateAsync)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$/i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.response.js", {${displayUpList},${purifyComment},${sponsorBlock},${logLevel}}) with requires_body=true, binary_body_mode=true, tag="ProtoBuf净化"

[MitM]
hostname=grpc.biliapi.net,app.bilibili.com,api.bilibili.com,api.live.bilibili.com,www.bilibili.com,line3-h5-mobile-api.biligame.com
