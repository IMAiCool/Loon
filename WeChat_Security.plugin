#!name = 微信安全保护
#!desc = 微信/WeChat 登录、账号安全、风控验证、解封、支付及核心服务直连；关键安全域名排除 MITM，降低代理/去广告规则误伤导致的登录、验证码、支付、账号验证异常。
#!author = 零一
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/WeChat.png
#!tag = 微信,安全,直连,支付
#!type = normal
#!system = iOS,iPadOS,macOS

# ==============================
# WeChat Security Guard for Loon
# 目标：
# 1. 微信核心服务强制 DIRECT
# 2. 登录/账号安全/验证/支付域名不经过 MITM
# 3. 不使用 DOMAIN-SUFFIX,qq.com / tencent.com 等过宽规则
# 4. 可与广告拦截规则共存，并优先保护微信关键链路
# ==============================

[Rule]
# --- 登录 / 账号安全 / 风控 / 解封 ---
DOMAIN,apd-pcdnwxlogin.teg.tencent-cloud.net,DIRECT
DOMAIN,btrace.qq.com,DIRECT
DOMAIN,weixin110.qq.com,DIRECT
DOMAIN,vweixinf.tc.qq.com,DIRECT
DOMAIN,wxapp.tc.qq.com,DIRECT
DOMAIN-SUFFIX,weixin.qq.com,DIRECT
DOMAIN-SUFFIX,weixin.com,DIRECT
DOMAIN-SUFFIX,wechat.com,DIRECT
DOMAIN-SUFFIX,wechatlegal.net,DIRECT
DOMAIN-SUFFIX,weixinsxy.com,DIRECT
DOMAIN-SUFFIX,weixinbridge.com,DIRECT

# --- 微信小程序 / 微信基础服务 ---
DOMAIN-SUFFIX,servicewechat.com,DIRECT
DOMAIN-SUFFIX,wx.qq.com,DIRECT
DOMAIN-SUFFIX,wxs.qq.com,DIRECT
DOMAIN-SUFFIX,wxapp.tc.qq.com,DIRECT
DOMAIN-SUFFIX,vweixinthumb.tc.qq.com,DIRECT
DOMAIN-SUFFIX,wechatos.net,DIRECT
DOMAIN-SUFFIX,wx.gtimg.com,DIRECT

# --- 微信支付 / Tenpay ---
DOMAIN,wx.tenpay.com,DIRECT
DOMAIN-SUFFIX,wechatpay.com,DIRECT
DOMAIN-SUFFIX,tenpay.com,DIRECT

# --- 头像 / 二维码 / 图片资源 ---
DOMAIN-SUFFIX,qlogo.cn,DIRECT
DOMAIN-SUFFIX,qpic.cn,DIRECT

# --- 地图 / 定位相关 ---
DOMAIN-SUFFIX,lbs.gtimg.com,DIRECT
DOMAIN-SUFFIX,map.qq.com,DIRECT
DOMAIN-SUFFIX,iot-tencent.com,DIRECT

# --- 微信网络与辅助服务 ---
DOMAIN,dldir1.qq.com,DIRECT
DOMAIN,slife.xy-asia.com,DIRECT
DOMAIN,soup.v.qq.com,DIRECT
DOMAIN,wup.imtt.qq.com,DIRECT
DOMAIN-SUFFIX,up-hl.3g.qq.com,DIRECT
DOMAIN-SUFFIX,yun-hl.3g.qq.com,DIRECT

[Mitm]
# 登录 / 安全 / 风控
hostname = -weixin110.qq.com, -apd-pcdnwxlogin.teg.tencent-cloud.net, -btrace.qq.com, -vweixinf.tc.qq.com, -wxapp.tc.qq.com, -*.weixin.qq.com, -*.weixin.com, -*.wechat.com, -*.wechatlegal.net, -*.weixinsxy.com, -*.weixinbridge.com, -*.servicewechat.com, -*.wx.qq.com, -*.wxs.qq.com, -*.wechatos.net, -wx.tenpay.com, -*.wechatpay.com, -*.tenpay.com, -*.qlogo.cn, -*.qpic.cn
